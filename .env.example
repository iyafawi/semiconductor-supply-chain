# Private local SQL Server. Integrated Windows authentication; no passwords in source.
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=SiliconWatch;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
SQLSERVER_DATABASE=SiliconWatch
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
INGESTION_POLL_SECONDS=600
RISK_HALF_LIFE_HOURS=48
MAX_EVENT_DAYS=7
EVENT_JACCARD_THRESHOLD=0.65
EVENT_CLUSTER_HOURS=48
REGIONAL_EXPOSURE_WEIGHT=0.65
LOW_CONFIDENCE_WEIGHT=0.5
HIGH_RISK_THRESHOLD=0.45
MODERATE_RISK_THRESHOLD=0.15
ALERT_CRITICALITY_THRESHOLD=50
# Change sources in backend/sources.json. Optional SOURCE_CONFIG may point to another file.
# Frontend uses local FastAPI; it never fetches external sources.
VITE_API_URL=http://127.0.0.1:8000
VITE_REFRESH_SECONDS=45

# Enable repeated paid OpenAI web searches in the background worker.
# Keep the API key on the backend, never in a VITE variable.
OPENAI_NEWS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
